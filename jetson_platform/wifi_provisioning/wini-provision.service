[Unit]
Description=Wini Wi-Fi Provisioning Portal (hotspot captive page)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
# root: nmcli control + binding port 80
User=root
ExecStart=/usr/bin/python3 -u /usr/local/bin/wini_provision_portal.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
