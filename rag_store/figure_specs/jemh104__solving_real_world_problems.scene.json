  "beats": [
    {
      "narration": "A garden's length is five metres more than its width, and its area is eighty-four square metres.",
      "anim_ms": 600,
      "hold_ms": 1100,
      "in": [
        {
          "t": "label",
          "text": "Area = 84 m²,  Length = Width + 5",
          "space": "canvas",
          "at": [
            0.5,
            0.24
          ],
          "anchor": "center",
          "size": 17,
          "color": "ink",
          "anim": "fade"
        }
      ],
      "claim_tags": [
        "visual_step_1"
      ]
    },
    {
      "narration": "Let the width be x, so the length is x plus five.",
      "anim_ms": 600,
      "hold_ms": 1100,
      "in": [
        {
          "t": "label",
          "text": "width = x,   length = x + 5",
          "space": "canvas",
          "at": [
            0.5,
            0.35
          ],
          "anchor": "center",
          "size": 17,
          "color": "ink",
          "anim": "fade"
        }
      ],
      "claim_tags": [
        "visual_step_2"
      ]
    },
    {
      "narration": "Area is length times width, so x times x plus five equals eighty-four.",
      "anim_ms": 600,
      "hold_ms": 1100,
      "in": [
        {
          "t": "label",
          "text": "x(x + 5) = 84",
          "space": "canvas",
          "at": [
            0.5,
            0.46
          ],
          "anchor": "center",
          "size": 23,
          "color": "ink",
          "anim": "fade"
        }
      ],
      "claim_tags": [
        "visual_step_3"
      ]
    },
    {
      "narration": "Expand and rearrange into a quadratic equation.",
      "anim_ms": 600,
      "hold_ms": 1100,
      "in": [
        {
          "t": "label",
          "text": "x² + 5x − 84 = 0",
          "space": "canvas",
          "at": [
            0.5,
            0.57
          ],
          "anchor": "center",
          "size": 23,
          "color": "ink",
          "anim": "fade"
        }
      ],
      "claim_tags": [
        "visual_step_4"
      ]
    },
    {
      "narration": "Factor it into x minus seven times x plus twelve.",
      "anim_ms": 600,
      "hold_ms": 1100,
      "in": [
        {
          "t": "label",
          "text": "(x − 7)(x + 12) = 0",
          "space": "canvas",
          "at": [
            0.5,
            0.68
          ],
          "anchor": "center",
          "size": 20,
          "color": "ink",
          "anim": "fade"
        }
      ],
      "claim_tags": [
        "visual_step_5"
      ]
    },
    {
      "narration": "So x is seven or minus twelve.",
      "anim_ms": 600,
      "hold_ms": 1100,
      "in": [
        {
          "t": "label",
          "text": "x = 7   or   x = −12",
          "space": "canvas",
          "at": [
            0.5,
            0.79
          ],
          "anchor": "center",
          "size": 20,
          "color": "ink",
          "anim": "fade"
        }
      ],
      "claim_tags": [
        "visual_step_6"
      ]
    },
    {
      "narration": "Width can't be negative, so the width is seven metres and the length is twelve.",
      "anim_ms": 600,
