# Large binary files
*.npy
*.npz
*.faiss
*.pyd
*.dll
*.exe
*.so

# Python cache
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
*.egg

# Google Cloud SDK (large directory)
google-cloud-sdk/

# IDE and local files
.claude/
.agents/
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
.env
*.log

# Installation/build artifacts
install_mode/
*.bak
*.tmp

# Large datasets (optional - uncomment if needed)
# *.jsonl
# *.json

# Virtual environments
venv/
env/
ENV/

# Local voice-test artifacts
.voice_runs/

# Parent dashboard: fetched Jetson snapshots (regenerated on every refresh)
_parent_cache/

# wini_ui on-device artifacts (the LVGL clone + cmake build live on the Pi only)
wini_ui/lvgl/
wini_ui/build/
wini_ui/.shots/

# device runtime logs (run_wini_package.sh appends here)
logs/

# Device credentials (password inside) — never commit
PI_ACCESS.md

# Runtime state and per-learner logs. These are DEVICE OUTPUT, not source: they
# carry a specific child's utterances and progress, they churn on every turn,
# and this repo has a public remote. learner_state.json / learning_log.jsonl are
# already tracked from earlier; these are the ones that never should be.
rag_store/safety_alerts.jsonl
learner_state.backup.json
learner_state.*.json

# One-off pipeline test artifacts (regenerated by the dataset test run)
dataset/_pipeline_test_*

# Superseded split files, kept locally for provenance only. splits.json is the
# shared train/val/test contract (see CLAUDE.md) — the old ones must never be
# mistaken for it.
models/exemplar_classifier/_old_splits/

# Jetson field-diagnostic scratch scripts (device-specific, not part of the build)
_jetson_diag/

# cloud_workspace_v8 source archive snapshot (284MB, exceeds GitHub 100MB limit)
cloud_workspace_v8/source.tgz
